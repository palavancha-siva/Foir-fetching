# Server Configuration
PORT=5104
DEFAULT_ROUTE_URL=/api/crm
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/foir_data
PGSSLMODE=disable
ADMIN_API_TOKEN=your_32_character_admin_token_here

# Security & Encryption (32-byte hex for AES-256-GCM)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
INTERNAL_API_KEY=fin_internal_secret_key_crm_2026

# JWT Key Paths
JWT_PRIVATE_KEY_PATH=keys/jwtRS256.key
JWT_PUBLIC_KEY_PATH=keys/jwtRS256.key.pub

# CORS Configuration (e.g. http://localhost:3000 for frontend)
CORS_ORIGIN=*
